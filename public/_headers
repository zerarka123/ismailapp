/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.open-meteo.com https://marine-api.open-meteo.com; media-src 'self' blob: https://*.supabase.co; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# The sign-in page (including every ?next=... variant) must stay out of search results
/login
  X-Robots-Tag: noindex

# Form pages that need an account: keep them out of search results
/register-business
  X-Robots-Tag: noindex
/sell
  X-Robots-Tag: noindex
/fish/post
  X-Robots-Tag: noindex

# One canonical address per public page, so ?lang= and similar variants are grouped
/
  Link: <https://app.marsadz.app/>; rel="canonical"
/support
  Link: <https://app.marsadz.app/support>; rel="canonical"
/privacy
  Link: <https://app.marsadz.app/privacy>; rel="canonical"
/terms
  Link: <https://app.marsadz.app/terms>; rel="canonical"
/guide/*
  Link: <https://app.marsadz.app/guide/:splat>; rel="canonical"

# Files built by Vite carry a content hash in their name: the browser can keep them for a year without re-asking
/assets/*
  Cache-Control: public, max-age=31536000, immutable
